<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Shivashish Properties</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/style.css" rel="stylesheet">
</head>

<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->


          <!-- Navbar Start -->
          <div class="container-fluid nav-bar bg-transparent"> 
            <nav class="navbar navbar-expand-lg bg-white navbar-light py-0 px-4">
                <a href="/home" class="navbar-brand d-flex align-items-center text-center">
                    <div class="icon p-2 me-2">
                        <img class="img-fluid" src="/img/icon-deal.png" alt="Property Icon" style="width: 30px; height: 30px;">
                    </div>
                    <h1 class="m-0 text-primary">Shivashish Properties</h1>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div class="navbar-nav ms-auto">
                        <a href="/home" class="nav-item nav-link ">Home</a>
                        <a href="/about" class="nav-item nav-link  active">About</a>
                        <div class="nav-item dropdown">
                            <a href="/home" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Property</a>
                            <div class="dropdown-menu rounded-0 m-0">
                                <a href="/home/offices-in-indore" class="dropdown-item">office</a>
                                <a href="/home/lands-in-indore" class="dropdown-item">land</a>
                                <a href="/home/plots-in-indore" class="dropdown-item">plot</a>
                                <a href="/home/houses-in-indore" class="dropdown-item">house</a>
                            </div>
                        </div>
                        <a href="/home/reviews" class="nav-item nav-link">Reviews</a>
        
                        <% if(!currUser) { %>
                            <a href="/user/login" class="nav-item nav-link">
                                <button type="button" class="btn btn-primary btn-sm">Login</button>
                            </a>
                        <% } else { %>
                            <div class="nav-item dropdown" style="padding-top: 20px">
                                <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <%= currUser.username %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/user/profile">Profile</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="confirmLogout()">Logout</a></li>
                                </ul>
                            </div>
                        <% } %>   
                    </div>
                </div>
            </nav>
        </div>
        
          <!-- Navbar End -->
  
  


        <!-- Header Start -->
        <div class="container-fluid header bg-white p-0">
            <div class="row g-0 align-items-center flex-column-reverse flex-md-row">
                <div class="col-md-6 p-5 mt-lg-5">
                    <h1 class="display-5 animated fadeIn mb-4">About Us</h1> 
                        <nav aria-label="breadcrumb animated fadeIn">
                        <ol class="breadcrumb text-uppercase">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item"><a href="#">Pages</a></li>
                            <li class="breadcrumb-item text-body active" aria-current="page">About</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-md-6 animated fadeIn">
                    <img class="img-fluid" src="img/header.jpg" alt="Office space for sale in Indore">
                </div>
            </div>
        </div>
        <!-- Header End -->

        
        <!-- Team Start -->
        <div class="container-xxl py-5">
            <div class="container">
                <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                    <h1 class="mb-3">Property Agents</h1>
                </div>
                <div class="row g-2" style="align-items: center; justify-content: center;">
                    
                    <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                        <div class="team-item rounded overflow-hidden" style="margin: 5px;">
                            <div class="position-relative">
                                <img class="img-fluid" src="img/agent1.jpeg" alt="contact for buying properties" style="height: 275px;">
                                <div class="position-absolute start-50 top-100 translate-middle d-flex align-items-center">
                                    <a class="btn btn-square mx-1" href="https://www.facebook.com/hariomthakurcongress/" target=”_blank”><i class="fab fa-facebook-f"></i></a>
                                    <a class="btn btn-square mx-1" href="https://www.instagram.com/hariomthakur7777/?hl=en" target=”_blank”><i class="fab fa-instagram"></i></a>
                                </div>
                            </div>
                            <div class="text-center p-4 mt-3">
                                <h5 class="fw-bold mb-0">Hariom Thakur</h5>
                                <small>Founder</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.7s" style="margin: 5px;">
                        <div class="team-item rounded overflow-hidden">
                            <div class="position-relative">
                                <img class="img-fluid" src="img/agent2.jpeg" alt="contact for buying properties" style="height: 275px;">
                                <div class="position-absolute start-50 top-100 translate-middle d-flex align-items-center">
                                    <a class="btn btn-square mx-1" href="https://www.facebook.com/rounakthakur7777/" target=”_blank”><i class="fab fa-facebook-f"></i></a>
                                    <a class="btn btn-square mx-1" href="https://www.instagram.com/rounak_thakur/?hl=en" target=”_blank”><i class="fab fa-instagram"></i></a>
                                </div>
                            </div>
                            <div class="text-center p-4 mt-3">
                                <h5 class="fw-bold mb-0">Rounak thakur</h5>
                                <small>CEO</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Team End -->
        
        <!-- Search Start -->
        
        <!-- About Start -->
        <div class="container-xxl py-5">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                        <div class="about-img position-relative overflow-hidden p-5 pe-0">
                            <img class="img-fluid w-100" src="img/about.jpg">
                        </div>
                    </div>
                    <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                        <h1 class="mb-4">#1 Place To Find The Perfect Property in Indore</h1>
                        <p class="mb-4"> Shivashish Properties stands out as a premier real estate agency in Indore, celebrated for its comprehensive property solutions and deep local expertise. </p>
                        <p><i class="fa fa-check text-primary me-3"></i>Indore's Real Estate Experts with Local Market Mastery</p>
                        <p><i class="fa fa-check text-primary me-3"></i>15+ Trusted years in Real Estate Services in Indore </p>
                        <p><i class="fa fa-check text-primary me-3"></i>Prime Properties in Indore for All Budgets and Needs</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- About End -->


        <!-- Call to Action Start -->
        <%- include("call.ejs") %>
        <!-- Call to Action End -->



        <!-- Footer Start -->
        <%- include('footer.ejs') %>
        <!-- Footer End -->


        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    <!-- JavaScript Libraries -->
    <%- include('allscripts.ejs') %>

</body>

</html>