<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('head.ejs') %>
    <style>
        .abnormal-main-body {
            padding: 15px;
        }

        .abnormal-card {
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, .1), 0 1px 2px 0 rgba(0, 0, 0, .06);
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            background-color: #fff;
            background-clip: border-box;
            border: 0 solid rgba(0, 0, 0, .125);
            border-radius: .25rem;
        }

        .abnormal-card-body {
            flex: 1 1 auto;
            min-height: 1px;
            padding: 1rem;
        }

        .abnormal-gutters-sm {
            margin-right: -8px;
            margin-left: -8px;
        }

        .abnormal-gutters-sm>.col, .abnormal-gutters-sm>[class*=col-] {
            padding-right: 8px;
            padding-left: 8px;
        }

        .abnormal-mb-3, .abnormal-my-3 {
            margin-bottom: 1rem !important;
        }

        .abnormal-bg-gray-300 {
            background-color: #e2e8f0;
        }

        .abnormal-h-100 {
            height: 100% !important;
        }

        .abnormal-shadow-none {
            box-shadow: none !important;
        }
    </style>
</head>

<body>
    <%- include("flash.ejs") %> 
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->

       <!-- Navbar Start -->
       <div class="container-fluid nav-bar bg-transparent"> 
        <nav class="navbar navbar-expand-lg bg-white navbar-light py-0 px-4">
            <a href="/home" class="navbar-brand d-flex align-items-center text-center">
                <div class="icon p-2 me-2">
                    <img class="img-fluid" src="/img/icon-deal.png" alt="Property Icon" style="width: 30px; height: 30px;">
                </div>
                <h1 class="m-0 text-primary">Shivashish Properties</h1>
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto">
                    <a href="/home" class="nav-item nav-link">Home</a>
                    <a href="/home/sell" class="nav-item nav-link">Sell</a>
                    <div class="nav-item dropdown">
                        <a href="/home" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Property</a>
                        <div class="dropdown-menu rounded-0 m-0">
                            <a href="/home/offices-in-indore" class="dropdown-item">office</a>
                            <a href="/home/lands-in-indore" class="dropdown-item">land</a>
                            <a href="/home/plots-in-indore" class="dropdown-item">plot</a>
                            <a href="/home/houses-in-indore" class="dropdown-item">house</a>
                        </div>
                    </div>
                    <a href="/home/reviews" class="nav-item nav-link">Reviews</a>
    
                    <% if(!currUser) { %>
                        <a href="/user/login" class="nav-item nav-link">
                            <button type="button" class="btn btn-primary btn-sm">Login</button>
                        </a>
                    <% } else { %>
                        <div class="nav-item dropdown" style="padding-top: 20px">
                            <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <%= currUser.username %>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/user/<%=currUser._id %>">Profile</a></li>
                                <li><a class="dropdown-item" href="/user/logout" onclick="confirmLogout(event)">Logout</a></li>
                            </ul>
                        </div>
                    <% } %>   
                </div>
            </div>
        </nav>
    </div>
    
    <!-- Navbar End -->
        <!-- Navbar Start -->
        
        <!-- Navbar End -->

        <div class="container">
            <div class="abnormal-main-body">
                <div class="row abnormal-gutters-sm">
                    <div class="col-md-4 abnormal-mb-3">
                        <div class="abnormal-card">
                            <div class="abnormal-card-body">
                                <div class="d-flex flex-column align-items-center text-center">
                                    <img src="<%= user.image %>" alt="Admin" class="rounded-circle" width="150">
                                    <div class="mt-3">
                                        <h4><%= user.username %></h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="abnormal-card abnormal-mb-3">
                            <div class="abnormal-card-body">
                                <!-- Profile details -->
                                <div class="row">
                                    <div class="col-sm-3">
                                        <h6 class="abnormal-mb-0">Full Name</h6>
                                    </div>
                                    <div class="col-sm-9 text-secondary">
                                        <%= user.username %>
                                    </div>
                                </div>
                                <hr>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <h6 class="abnormal-mb-0">Email</h6>
                                    </div>
                                    <div class="col-sm-9 text-secondary">
                                        <%= user.email %>
                                    </div>
                                </div>
                                <hr>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <h6 class="abnormal-mb-0">Phone</h6>
                                    </div>
                                    <div class="col-sm-9 text-secondary">
                                        <%= user.phone %>
                                    </div>
                                </div>
                                <hr>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <a class="btn btn-info" target="__blank" href="/user/edit/<%= user._id %>">Edit</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container-xxl py-5"> 
                <div class="container">
                    <div class="row g-0 gx-5 align-items-end">
                        <div class="col-lg-6">
                            <div class="text-start mx-auto mb-5 wow slideInLeft" data-wow-delay="0.1s">
                                <h1 class="mb-3">All the properties you have added are listed below.
                                </h1>
                            </div>
                        </div>
                    </div>
                    
        </div>
        <div class="tab-content">
            <div id="tab-1" class="tab-pane fade show p-0 active">
                <div class="row g-4">
                    <% for(let i=0; i<properties.length; i++){ %>
                    <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                        <div class="property-item rounded overflow-hidden">
                            <div class="position-relative overflow-hidden">
                                <a href="/home/offices-in-indore/<%= properties[i].id%>">
                                    <img class="img-fluid" src="<%= properties[i].image %>" alt="Property for sale in Indore">
                                </a>
                                <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3"><%= properties[i].SRB %></div>
                                <div class="bg-white rounded-top text-primary position-absolute start-0 bottom-0 mx-4 pt-1 px-3"><%= properties[i].type %></div>
                            </div>
                            <div class="p-4 pb-0">
                                <h5 class="text-primary mb-3">Rs.<%= properties[i].rate %></h5>
                                <a class="d-block h5 mb-2" href="/home/offices-in-indore/<%= properties[i].id %>"><%= properties[i].Name %></a>
                                <p><i class="fa fa-map-marker-alt text-primary me-2"></i><%= properties[i].location %></p>
                            </div>
                            <div class="d-flex border-top">
                                <small class="flex-fill text-center border-end py-2">
                                    <i class="fa fa-ruler-combined text-primary me-2"></i><%= properties[i].size %>
                                </small>
                                <form action="/user/<%= properties[i].userid %>/<%= properties[i]._id %>" method="post">
                                    <button style="background-color: red;">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
            <% if(properties.length == 0) { %>
            <h1>You have not added or sold any properties yet.
            </h1>
            <% } %>
        </div>
    </div>
</div>

        <!-- Footer Start -->
        <%- include("footer.ejs") %>
        <!-- Footer End -->
    </div>
    
    <%- include('allscripts.ejs') %>
</body>

</html>
<script>
    function confirmLogout(event) {
      // Show confirmation alert
      event.preventDefault();
      const confirmation = confirm("Are you sure you want to logout?");
      
      if (confirmation) {
        // If user clicks "Yes", proceed with logout
        window.location.href = "/user/logout";  // Redirect to logout route
      } else {
        // If user clicks "No", do nothing
        return;
      }
    }
  </script>