<!DOCTYPE html>
<html lang="en">

<head>
   <%- include('head.ejs') %>
    <style>
        .containe {
    display: flex;
    justify-content: center; /* Centers the anchor horizontally */
}

/* Anchor tag styling */
.containe a {
    display: inline-block;
    padding: 10px 20px;
    background-color: #2575fc;
    color: white;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    box-sizing: border-box;
    min-width: 300px;
    max-width: 300px; /* Ensures the anchor doesn't become too wide */
    width: auto; /* Auto width based on content */
    transition: background-color 0.3s ease, transform 0.3s ease;
}

/* Hover effect */
.containe a:hover {
    background-color: #1a5bb8;
    transform: translateY(-2px);
}

    </style>
</head>

<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->

        <!-- Navbar Start -->
        <div class="container-fluid nav-bar bg-transparent"> 
            <nav class="navbar navbar-expand-lg bg-white navbar-light py-0 px-4">
                <a href="/home" class="navbar-brand d-flex align-items-center text-center">
                    <div class="icon p-2 me-2">
                        <img class="img-fluid" src="/img/icon-deal.png" alt="Property Icon" style="width: 30px; height: 30px;">
                    </div>
                    <h1 class="m-0 text-primary">Shivashish Properties</h1>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div class="navbar-nav ms-auto">
                        <a href="/home" class="nav-item nav-link">Home</a>
                        <a href="/home/sell" class="nav-item nav-link">Sell</a>
                        <div class="nav-item dropdown">
                            <a href="/home" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Property</a>
                            <div class="dropdown-menu rounded-0 m-0">
                                <a href="/home/offices-in-indore" class="dropdown-item">office</a>
                                <a href="/home/lands-in-indore" class="dropdown-item">land</a>
                                <a href="/home/plots-in-indore" class="dropdown-item">plot</a>
                                <a href="/home/houses-in-indore" class="dropdown-item">house</a>
                            </div>
                        </div>
                        <a href="/home/reviews" class="nav-item nav-link active">Reviews</a>
        
                        <% if(!currUser) { %>
                            <a href="/user/login" class="nav-item nav-link">
                                <button type="button" class="btn btn-primary btn-sm">Login</button>
                            </a>
                        <% } else { %>
                            <div class="nav-item dropdown" style="padding-top: 20px">
                                <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <%= currUser.username %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/user/<%=currUser._id %>">Profile</a></li>
                                    <li><a class="dropdown-item" href="/user/logout" onclick="confirmLogout(event)">Logout</a></li>
                                </ul>
                            </div>
                        <% } %>   
                    </div>
                </div>
            </nav>
        </div>
        
        <!-- Navbar End -->
        <!-- Header Start -->
        <div class="container-fluid header bg-white p-0">
            <div class="row g-0 align-items-center flex-column-reverse flex-md-row">
                <div class="col-md-6 p-5 mt-lg-5">
                    <h1 class="display-5 animated fadeIn mb-4">Reviews from our clients</h1> 
                        <nav aria-label="breadcrumb animated fadeIn">
                        <ol class="breadcrumb text-uppercase">
                            <li class="breadcrumb-item"><a href="#">Pages</a></li>
                            <li class="breadcrumb-item text-body active" aria-current="page">Reviews</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-md-6 animated fadeIn">
                    <img class="img-fluid" src="/img/header.jpg" alt="property icon">
                </div>
            </div>
        </div>
        <!-- Header End -->

        <!-- Testimonial Start -->
        <div class="container-xxl py-5">
            <div class="container">
                <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                    <h1 class="mb-3">Our Clients Say!</h1>
                    <p>"Finding the perfect property in Indore was effortless with Shivashish Properties. Their team is knowledgeable, responsive, and truly cares about meeting client needs. Highly recommended!"</p>
                </div>
                <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.1s">
                <% for(let i=0; i<reviews.length; i++){ %>
                    <div class="testimonial-item bg-light rounded p-3">
                        <div class="bg-white border rounded p-4">
                            <p><%= reviews[i].content %></p>
                            <div class="d-flex align-items-center">
                                <img class="img-fluid flex-shrink-0 rounded" src= <%= reviews[i].image %> style="width: 45px; height: 45px;">
                                <div class="ps-3">
                                    <h6 class="fw-bold mb-1"><%= reviews[i].name %></h6>
                                    <small><%= reviews[i].profession%></small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-center">
            <a href="/home/addreview" class="containe btn btn-primary py-3 px-5 me-3 animated fadeIn w-40 text-center">
              Add a Review
            </a>
          </div>
        <!-- Testimonial End -->

        <!-- Footer Start -->
        <%- include('footer.ejs') %>
        <!-- Footer End -->


        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    
    <%- include('allscripts.ejs') %>
</body>

</html>
<script>
    function confirmLogout(event) {
      // Show confirmation alert
      event.preventDefault();
      const confirmation = confirm("Are you sure you want to logout?");
      
      if (confirmation) {
        // If user clicks "Yes", proceed with logout
        window.location.href = "/user/logout";  // Redirect to logout route
      } else {
        // If user clicks "No", do nothing
        return;
      }
    }
  </script>