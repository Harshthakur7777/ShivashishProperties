<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('head.ejs') %>
</head>

<body>
    <%- include("flash.ejs") %>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->


        <!-- Navbar Start -->
        <div class="container-fluid nav-bar bg-transparent"> 
            <nav class="navbar navbar-expand-lg bg-white navbar-light py-0 px-4">
                <a href="/home" class="navbar-brand d-flex align-items-center text-center">
                    <div class="icon p-2 me-2">
                        <img class="img-fluid" src="/img/icon-deal.png" alt="Property Icon" style="width: 30px; height: 30px;">
                    </div>
                    <h1 class="m-0 text-primary">Shivashish Properties</h1>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div class="navbar-nav ms-auto">
                        <a href="/home" class="nav-item nav-link  active">Home</a>
                        <a href="/home/sell" class="nav-item nav-link">Sell</a>
                        <div class="nav-item dropdown">
                            <a href="/home" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Property</a>
                            <div class="dropdown-menu rounded-0 m-0">
                                <a href="/home/offices-in-indore" class="dropdown-item">office</a>
                                <a href="/home/lands-in-indore" class="dropdown-item">land</a>
                                <a href="/home/plots-in-indore" class="dropdown-item">plot</a>
                                <a href="/home/houses-in-indore" class="dropdown-item">house</a>
                            </div>
                        </div>
                        <a href="/home/reviews" class="nav-item nav-link">Reviews</a>
        
                        <% if(!currUser) { %>
                            <a href="/user/login" class="nav-item nav-link">
                                <button type="button" class="btn btn-primary btn-sm">Login</button>
                            </a>
                        <% } else { %>
                            <div class="nav-item dropdown" style="padding-top: 20px">
                                <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <%= currUser.username %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/user/<%=currUser._id %>">Profile</a></li>
                                    <li><a class="dropdown-item" href="/user/logout" onclick="confirmLogout(event)">Logout</a></li>
                                </ul>
                            </div>
                        <% } %>   
                    </div>
                </div>
            </nav>
        </div>


        <!-- Header Start -->
        <div class="container-fluid header bg-white p-0">
            <div class="row g-0 align-items-center flex-column-reverse flex-md-row">
                <div class="col-md-6 p-5 mt-lg-5">
                    <h1 class="display-5 animated fadeIn mb-4" style="font-size:2.25rem;">Find the Best <span class="text-primary">Properties in Indore</span>  with <span class="text-primary">Shivashish Properties</span></h1>
                    <p class="animated fadeIn mb-4 pb-2" style="font-size: 1rem; color: black;">Your Trusted Partner in <span class="text-primary">Buying, Selling, and Renting</span> Premium Plots, Offices, Lands, and Houses <span class="text-primary">in Indore.</span></p>
                    <a href="/home" class="btn btn-primary py-3 px-5 me-3 animated fadeIn">Get Started</a>
                </div>
                <div class="col-md-6 animated fadeIn">
                    <div class="owl-carousel header-carousel">
                        <div class="owl-carousel-item">
                            <img class="img-fluid" src="img/carousel-1.jpg" alt="">
                        </div>
                        <div class="owl-carousel-item">
                            <img class="img-fluid" src="img/carousel-2.jpg" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Header End -->

        <!-- Search Start -->
        <%- include("propertySearch.ejs") %>
        <!-- Search End -->


        <!-- Category Start -->
        <div class="container-xxl py-5">
            <div class="container">
                <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                    <h1 class="mb-3">Property Types</h1>
                    <p>Whether you're searching for the perfect plot to build your dream home, a strategic office space to grow your business, expansive lands for development, or a ready-to-move-in house, we have you covered</p>
                </div>
                <div class="row g-4 abc">
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                        <a class="cat-item d-block bg-light text-center rounded p-3" href="/home/offices-in-indore">
                            <div class="rounded p-4">
                                <div class="icon mb-3">
                                    <img class="img-fluid" src="img/icon-house.png" alt="Office icon">
                                </div>
                                <h6>Office</h6>
                                <span>3 Properties</span>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
                        <a class="cat-item d-block bg-light text-center rounded p-3" href="/home/houses-in-indore">
                            <div class="rounded p-4">
                                <div class="icon mb-3">
                                    <img class="img-fluid" src="img/icon-apartment.png" alt="house Icon">
                                </div>
                                <h6>House</h6>
                                <span>1 Properties</span>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
                        <a class="cat-item d-block bg-light text-center rounded p-3" href="/home/lands-in-indore">
                            <div class="rounded p-4">
                                <div class="icon mb-3">
                                    <img class="img-fluid" src="img/icon-house.png" alt="plot Icon">
                                </div>
                                <h6>Lands</h6>
                                <span>1 Properties</span>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
                        <a class="cat-item d-block bg-light text-center rounded p-3" href="/home/plots-in-indore">
                            <div class="rounded p-4">
                                <div class="icon mb-3">
                                    <img class="img-fluid" src="img/icon-housing.png" alt="Land Icon">
                                </div>
                                <h6>Plots</h6>
                                <span>2 Properties</span>
                            </div>
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
        <!-- Category End -->

        <!-- Property List Start -->
        <h1 style="text-align:center;">Property Listing</h1>
        <div class="container-xxl" style="padding-top: 0; margin-top: 0;">
            <div class="container">
                <div class="row g-0 gx-5 align-items-end">
                    <div class="col-lg-6">
                        <div class="text-start mx-auto mb-5 wow slideInLeft" data-wow-delay="0.1s">
                        </div>
                    </div>
                    
                </div>
                <div class="tab-content">
                    <div id="tab-1" class="tab-pane fade show p-0 active">
                        <div class="row g-4" >
                            
                            <div class="col-lg-3 col-md-5 wow fadeInUp" data-wow-delay="0.5s">
                                <div class="property-item rounded overflow-hidden">
                                    <div class="position-relative overflow-hidden">
                                        <a href="/home/offices-in-indore"><img class="img-fluid" src="<%- indexData.office.image %>" alt="Office space for sale in Indore" style="height: 225px; width: 300px;"></a>
                                        <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3"><%- indexData.office.SRB %></div>
                                        <div class="bg-white rounded-top text-primary position-absolute start-0 bottom-0 mx-4 pt-1 px-3">Office</div>
                                    </div>
                                    <div class="p-4 pb-0">
                                        <h5 class="text-primary mb-3">Rs. <%= Number(indexData.office.rate.replace(/[^0-9]/g, '')).toLocaleString('en-IN') %></h5>
                                        <a class="d-block h5 mb-2" href="/home/offices-in-indore"><%- indexData.office.Name %></a>
                                        <p><i class="fa fa-map-marker-alt text-primary me-2"></i><%- indexData.office.location %></p>
                                    </div>
                                    <div class="d-flex border-top">
                                        <small class="flex-fill text-center border-end py-2"><i class="fa fa-ruler-combined text-primary me-2"></i><%- indexData.office.size %></small>
                                    </div>
                                    <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.1s">
                                        <a class="btn btn-primary py-2 px-5" href="/home/offices-in-indore">Browse More Offices</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-5 wow fadeInUp" data-wow-delay="0.1s">
                                <div class="property-item rounded overflow-hidden">
                                    <div class="position-relative overflow-hidden">
                                        <a href="/home/houses-in-indore"><img class="img-fluid" src="<%- indexData.house.image %>" alt="House for sale in Indore" style="height: 225px; width: 300px;"></a>
                                        <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3"><%- indexData.house.SRB %></div>
                                        <div class="bg-white rounded-top text-primary position-absolute start-0 bottom-0 mx-4 pt-1 px-3">House</div>
                                    </div>
                                    <div class="p-4 pb-0">
                                        <h5 class="text-primary mb-3">Rs. <%= Number(indexData.house.rate.replace(/[^0-9]/g, '')).toLocaleString('en-IN') %></h5>
                                        <a class="d-block h5 mb-2" href="/home/houses-in-indore"><%- indexData.house.Name %></a>
                                        <p><i class="fa fa-map-marker-alt text-primary me-2"></i><%- indexData.house.location %></p>
                                    </div>
                                    <div class="d-flex border-top">
                                        <small class="flex-fill text-center border-end py-2"><i class="fa fa-ruler-combined text-primary me-2"></i><%- indexData.office.size %></small>
                                    </div>
                                    <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.1s">
                                        <a class="btn btn-primary py-2 px-5" href="/home/houses-in-indore">Browse More Houses</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-5 wow fadeInUp" data-wow-delay="0.3s">
                                <div class="property-item rounded overflow-hidden">
                                    <div class="position-relative overflow-hidden">
                                        <a href="/home/plots-in-indore"><img class="img-fluid" src="<%- indexData.plot.image %>" alt="Plot for sale in Indore" style="height: 225px; width: 300px;"></a>
                                        <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3"><%- indexData.plot.SRB %></div>
                                        <div class="bg-white rounded-top text-primary position-absolute start-0 bottom-0 mx-4 pt-1 px-3">Home</div>
                                    </div>
                                    <div class="p-4 pb-0">
                                        <h5 class="text-primary mb-3">Rs. <%= Number(indexData.plot.rate.replace(/[^0-9]/g, '')).toLocaleString('en-IN') %></h5>
                                        <a class="d-block h5 mb-2" href="/home/plots-in-indore"><%- indexData.plot.Name %></a>
                                        <p><i class="fa fa-map-marker-alt text-primary me-2"></i><%- indexData.plot.location%></p>
                                    </div>
                                    <div class="d-flex border-top">
                                        <small class="flex-fill text-center border-end py-2"><i class="fa fa-ruler-combined text-primary me-2"></i><%- indexData.plot.size %></small>
                                    </div>
                                    <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.1s">
                                        <a class="btn btn-primary py-2 px-5" href="/home/plots-in-indore">Browse More Plots</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-5 wow fadeInUp" data-wow-delay="0.5s">
                                <div class="property-item rounded overflow-hidden">
                                    <div class="position-relative overflow-hidden">
                                        <a href="/home/lands-in-indore"><img class="img-fluid" src="<%- indexData.land.image %>" style="height: 225px; width: 300px;"></a>
                                        <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3"><%- indexData.land.SRB %></div>
                                        <div class="bg-white rounded-top text-primary position-absolute start-0 bottom-0 mx-4 pt-1 px-3">Land</div>
                                    </div>
                                    <div class="p-4 pb-0">
                                        <h5 class="text-primary mb-3">Rs. <%= Number(indexData.land.rate.replace(/[^0-9]/g, '')).toLocaleString('en-IN') %></h5>
                                        <a class="d-block h5 mb-2" href="/home/lands-in-indore"><%- indexData.land.Name %></a>
                                        <p><i class="fa fa-map-marker-alt text-primary me-2"></i><%- indexData.land.location %></p>
                                    </div>
                                    <div class="d-flex border-top">
                                        <small class="flex-fill text-center border-end py-2"><i class="fa fa-ruler-combined text-primary me-2"></i><%- indexData.land.size %></small>
                                    </div>
                                    <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.1s">
                                        <a class="btn btn-primary py-2 px-5" href="/home/lands-in-indore">Browse More Lands</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
        <!-- Property List End -->    
         <!-- About Start -->
         <div class="container-xxl py-5">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                        <div class="about-img position-relative overflow-hidden p-5 pe-0">
                            <img class="img-fluid w-100" src="img/about.jpg">
                        </div>
                    </div>
                    <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                        <h1 class="mb-4">#1 Place To Find The Perfect Property in Indore</h1>
                        <p class="mb-4"> Shivashish Properties stands out as a premier real estate agency in Indore, celebrated for its comprehensive property solutions and deep local expertise. </p>
                        <p><i class="fa fa-check text-primary me-3"></i>Indore's Real Estate Experts with Local Market Mastery</p>
                        <p><i class="fa fa-check text-primary me-3"></i>15+ Trusted years in Real Estate Services in Indore </p>
                        <p><i class="fa fa-check text-primary me-3"></i>Prime Properties in Indore for All Budgets and Needs</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- About End -->
        <!-- Call to Action Start -->
        <%- include("call.ejs") %>
        <!-- Call to Action End -->

        

        <!-- Footer Start -->
        <%- include("footer.ejs") %>
        <!-- Footer End -->
   
        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>
    <script>
        function confirmLogout(event) {
          // Show confirmation alert
          event.preventDefault()
          const confirmation = confirm("Are you sure you want to logout?");
          
          if (confirmation) {
            // If user clicks "Yes", proceed with logout
            window.location.href = "/user/logout";  // Redirect to logout route
          } else {
            // If user clicks "No", do nothing
            return;
          }
        }
      </script>
      
    <%- include('allscripts.ejs') %>
</body>

</html>