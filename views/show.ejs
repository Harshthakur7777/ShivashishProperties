<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Shivashish Properties</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/style.css" rel="stylesheet">
    <style>
        body {
    margin: 0;
    font-family: Arial, sans-serif;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 10px;
    padding: 10px;
}

.grid-item {
    width: 100%;
    height: 100%;
    overflow: hidden;
    box-sizing: border-box; /* Ensure padding and border are included in the width and height */
}

.grid-item img {
    width: 100%;
    height: auto;
    max-width: 600px;
    max-height: 600px;
    object-fit: cover;
}

@media (max-width: 1200px) {
    .grid-container {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
    }
}

@media (max-width: 768px) {
    .grid-container {
        grid-template-columns: 1fr;
        gap: 5px;
        padding: 5px;
    }
}

@media (max-width: 480px) {
    .grid-item img {
        width: 100%;
        height: auto;
    }
}
.table-container {
    margin: 20px auto;
    width: 90%;
    max-width: 800px;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background-color: #ffffff; /* White background for the table */
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

th, td {
    padding: 12px 15px;
    text-align: left;
    border: 1px solid #dddddd;
}

th {
    background-color: #1e90ff; /* Blue background for headers */
    color: #ffffff; /* White text color for headers */
}

tbody tr:nth-child(even) {
    background-color: #f0f8ff; /* Light blue background for even rows */
}

tbody tr:hover {
    background-color: #add8e6; /* Light blue hover effect */
}

th:nth-child(1), td:nth-child(1) {
    width: 33%; /* First column takes 1/3 of the table width */
}

th:nth-child(2), td:nth-child(2) {
    width: 67%; /* Second column takes 2/3 of the table width */
}

@media (max-width: 768px) {
    th, td {
        padding: 10px 12px; /* Adjust padding on smaller screens */
    }

    th:nth-child(1), td:nth-child(1) {
        width: 35%; /* Adjust column width slightly on smaller screens */
    }

    th:nth-child(2), td:nth-child(2) {
        width: 65%;
    }
}

@media (max-width: 480px) {
    table, thead, tbody, th, td, tr {
        display: block;
        width: 100%;
        box-sizing: border-box;
    }

    tr {
        display: flex; /* Use flexbox for rows on small screens */
        flex-direction: row;
    }

    th, td {
        width: auto;
        flex: 1;
        padding: 10px 12px;
        text-align: left;
    }

    tr:nth-child(even) {
        background-color: #f0f8ff;
    }

    tr:hover {
        background-color: #add8e6;
    }
}
    </style>
</head>

<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
        
        
        <!-- Navbar Start -->
        <div class="container-fluid nav-bar bg-transparent"> 
            <nav class="navbar navbar-expand-lg bg-white navbar-light py-0 px-4">
                <a href="/home" class="navbar-brand d-flex align-items-center text-center">
                    <div class="icon p-2 me-2">
                        <img class="img-fluid" src="/img/icon-deal.png" alt="Property Icon" style="width: 30px; height: 30px;">
                    </div>
                    <h1 class="m-0 text-primary">Shivashish Properties</h1>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div class="navbar-nav ms-auto">
                        <a href="/home" class="nav-item nav-link">Home</a>
                        <a href="/home/sell" class="nav-item nav-link">Sell</a>
                        <div class="nav-item dropdown">
                            <a href="/home" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Property</a>
                            <div class="dropdown-menu rounded-0 m-0">
                                <a href="/home/offices-in-indore" class="dropdown-item">office</a>
                                <a href="/home/lands-in-indore" class="dropdown-item">land</a>
                                <a href="/home/plots-in-indore" class="dropdown-item">plot</a>
                                <a href="/home/houses-in-indore" class="dropdown-item">house</a>
                            </div>
                        </div>
                        <a href="/home/reviews" class="nav-item nav-link">Reviews</a>
        
                        <% if(!currUser) { %>
                            <a href="/user/login" class="nav-item nav-link">
                                <button type="button" class="btn btn-primary btn-sm">Login</button>
                            </a>
                        <% } else { %>
                            <div class="nav-item dropdown" style="padding-top: 20px">
                                <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <%= currUser.username %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/user/<%=currUser._id %>">Profile</a></li>
                                    <li><a class="dropdown-item" href="/user/logout" onclick="confirmLogout(event)">Logout</a></li>
                                </ul>
                            </div>
                        <% } %>   
                    </div>
                </div>
            </nav>
        </div>
        <!-- Navbar End -->
        <%- include('flash.ejs') %>
        <!--body start-->    
        <div class="grid-container" style="text-align: center;">
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Property Name</th>
                            <th><%= property.Name %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>sale/rent/buy</td>
                            <td><%= property.SRB %></td>
                        </tr>
                        <tr>
                            <td>Price</td>
                            <td><%= property.rate %> Rs</td>
                        </tr>
                        <tr>
                            <td>Propery type</td>
                            <td><%= property.type %></td>
                        </tr>
                        <tr>
                            <td>Location</td>
                            <td><%= property.location %></td>
                        </tr>
                        <tr>
                            <td>Size</td>
                            <td><%= property.size %></td>
                        </tr>
                        <tr>
                            <td>Additional Information</td>
                            <td>Nothing</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <% for(let i=0; i<property.images.length; i++){ %>
                <div class="grid-item">
                    <img src="<%= property.images[i] %>" alt="<%- property.type %> space for sale in <%- property.area %> indore" >
                </div>
            <% } %>
        </div>
        <!--body end-->    

        <%- include('call.ejs') %>
        <!-- Footer Start -->
        <%- include("footer.ejs") %>
        <!-- Footer End -->


        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>
    <%- include('allscripts.ejs') %>

</body>

</html>
                       
<script>
    function confirmLogout(event) {
      // Show confirmation alert
      event.preventDefault();
      const confirmation = confirm("Are you sure you want to logout?");
      
      if (confirmation) {
        // If user clicks "Yes", proceed with logout
        window.location.href = "/user/logout";  // Redirect to logout route
      } else {
        // If user clicks "No", do nothing
        return;
      }
    }
  </script>