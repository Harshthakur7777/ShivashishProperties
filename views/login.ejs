<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('head.ejs') %>
    <style>
        * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    }

/* Apply the body styles only if there's no conflict */


/* Container styling */
.form-container {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    padding: 30px;
    max-width: 400px;
    margin: 40px auto; /* Center the form container */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.form-container:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

/* Heading styling */
.form-container h1 {
    text-align: center;
    color: #2575fc;
    margin-bottom: 25px;
    font-size: 28px;
    letter-spacing: 1.5px;
}

/* Form group styling */
.form-group {
    margin-bottom: 20px;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    background-color: #f9f9f9;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #2575fc;
    box-shadow: 0 0 8px rgba(37, 117, 252, 0.3);
    outline: none;
}

textarea {
    resize: vertical;
}

/* File input styling */
.file-input {
    position: relative;
    width: 100%;
    height: 50px;
    border: 2px solid #ccc;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f9f9f9;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

/* Hide the default file input */
.file-input input[type="file"] {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
}

/* Placeholder text styling */
#filePlaceholder {
    font-size: 16px;
    color: #888;
}

/* File input focus state */
.file-input input[type="file"]:focus + #filePlaceholder,
.file-input input[type="file"]:hover + #filePlaceholder {
    color: #2575fc;
}

/* When a file is selected, change the placeholder text */
.file-input input[type="file"]:valid + #filePlaceholder {
    color: #2575fc;
    font-weight: bold;
}

/* Styling the file input container on hover */
.file-input:hover {
    border-color: #2575fc;
    box-shadow: 0 0 8px rgba(37, 117, 252, 0.3);
}

/* Styling the file input container when active (file selected) */
.file-input input[type="file"]:valid {
    border-color: #28a745;
    box-shadow: 0 0 8px rgba(40, 167, 69, 0.3);
}

/* Button styling */
.form-container button {
    width: 100%;
    padding: 12px;
    background-color: #2575fc;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
}

.form-container button:hover {
    background-color: #1a5bb8;
    transform: translateY(-2px);
}

/* Mobile responsiveness */
@media (max-width: 768px) {
    .form-container {
        width: 90%;
        margin: 20px auto;
        padding: 20px;
    }

    .form-container h1 {
        font-size: 24px;
    }

    input[type="text"],
    textarea {
        font-size: 14px;
        padding: 10px;
    }

    .form-container button {
        font-size: 16px;
        padding: 10px;
    }
}

@media (max-width: 480px) {
    .form-container {
        width: 95%;
        margin: 20px auto;
        padding: 15px;
    }

    .form-container h1 {
        font-size: 22px;
    }

    input[type="text"],
    textarea {
        font-size: 14px;
        padding: 8px;
    }

    .form-container button {
        font-size: 14px;
        padding: 8px;
    }
}
</style>
</head>
